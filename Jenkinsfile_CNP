def assertHtmlReportExists = { String reportDir, String reportFile ->
    steps.sh "test -f '${reportDir}/${reportFile}'"
}

def ensureHtmlReportForPublishing = { String reportDir, String reportFile, String suiteName, String outcome = 'unknown' ->
    def reportPath = "${reportDir}/${reportFile}"
    if (fileExists(reportPath)) {
        echo "[playwright-report] Reusing generated report at ${reportPath}"
        return
    }
    if (!fileExists('scripts/ensure-odhin-report.js')) {
        error("Cannot create fallback report for ${suiteName}: scripts/ensure-odhin-report.js is missing from the workspace")
    }
    withEnv([
        "PW_ODHIN_ENSURE_REPORT_DIR=${reportDir}",
        "PW_ODHIN_ENSURE_REPORT_FILE=${reportFile}",
        "PW_ODHIN_ENSURE_SUITE_NAME=${suiteName}",
        "PW_ODHIN_ENSURE_OUTCOME=${outcome}"
    ]) {
        steps.sh '''
            node scripts/ensure-odhin-report.js \
              --report-dir "$PW_ODHIN_ENSURE_REPORT_DIR" \
              --report-file "$PW_ODHIN_ENSURE_REPORT_FILE" \
              --suite-name "$PW_ODHIN_ENSURE_SUITE_NAME" \
              --outcome "$PW_ODHIN_ENSURE_OUTCOME"
        '''
    }
}

def publishPlaywrightAccessibilityReport = { String reportName ->
    try {
        ensureHtmlReportForPublishing(
            playwrightAccessibilityReportDir,
            playwrightAccessibilityReportFile,
            reportName
        )
        publishHTML([
            allowMissing         : true,
            alwaysLinkToLastBuild: true,
            keepAll              : true,
            reportDir            : "${playwrightAccessibilityReportDir}/",
            reportFiles          : playwrightAccessibilityReportFile,
            reportName           : reportName
        ])
    } catch (Exception e) {
        if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
            throw e
        }
        if (e instanceof hudson.AbortException && ((e.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
            throw e
        }
        currentBuild.result = 'UNSTABLE'
        echo "[playwright-accessibility] Report publish failed; marking build unstable because this pack must publish Odhín evidence: ${e.getClass().getName()}: ${e.getMessage()}"
    }
}

def publishPlaywrightAccessibilityJUnit = {
    if (!fileExists(playwrightAccessibilityJunitFile)) {
        return
    }
    try {
        junit allowEmptyResults: false, testResults: playwrightAccessibilityJunitFile
    } catch (Exception e) {
        if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
            throw e
        }
        if (e instanceof hudson.AbortException && ((e.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
            throw e
        }
        echo "[playwright-accessibility] JUnit publish failed but is non-blocking: ${e.getClass().getName()}: ${e.getMessage()}"
    }
}

def publishPlaywrightJUnit = { String junitFile, String outcome ->
    if (!fileExists(junitFile)) {
        if (outcome == 'completed') {
            error "Playwright completed without producing JUnit results: ${junitFile}"
        }
        echo "[playwright-reporting] JUnit file absent after ${outcome}; preserving the runner result: ${junitFile}"
        return
    }
    try {
        junit allowEmptyResults: false, testResults: junitFile
    } catch (Exception e) {
        if (outcome == 'completed') {
            throw e
        }
        echo "[playwright-reporting] JUnit publication failed after ${outcome}; preserving the runner result: ${e.getClass().getName()}: ${e.getMessage()}"
    }
}

def publishPlaywrightLoadProfile = { String reportDir, String reportName ->
    def safeReportName = reportName.replaceAll(/[^A-Za-z0-9._-]/, '-')
    def slimReportDir = "functional-output/tests/playwright-published-reports/load-profile/${safeReportName}"
    try {
        steps.sh """
            node scripts/ensure-load-profile-report.js \\
              --report-dir '${reportDir}' \\
              --report-file '${playwrightLoadProfileReportFile}' \\
              --report-name '${reportName}' \\
              --wait-ms 30000
            if [ -f '${reportDir}/monitor.log' ]; then
              cat '${reportDir}/monitor.log'
            fi
            mkdir -p '${slimReportDir}'
            cp '${reportDir}/${playwrightLoadProfileReportFile}' '${slimReportDir}/${playwrightLoadProfileReportFile}'
        """
        steps.archiveArtifacts(allowEmptyArchive: false, artifacts: "${slimReportDir}/${playwrightLoadProfileReportFile}")
        publishHTML([
          allowMissing         : false,
          alwaysLinkToLastBuild: true,
          keepAll              : true,
          reportDir            : "${slimReportDir}/",
          reportFiles          : playwrightLoadProfileReportFile,
          reportName           : reportName
        ])
    } catch (Exception publishException) {
        if (publishException instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
            throw publishException
        }
        if (publishException instanceof hudson.AbortException && ((publishException.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
            throw publishException
        }
        currentBuild.result = 'UNSTABLE'
        echo "[playwright-load-profile] Report publication failed; marking build unstable: ${publishException.getClass().getName()}: ${publishException.getMessage()}"
    }
}

def startPlaywrightLoadProfile = { String reportDir, String label, String eventsFile ->
    steps.sh """
        set +e
        mkdir -p '${reportDir}'
        rm -f '${reportDir}/stop' '${reportDir}/monitor.pid' \\
          '${reportDir}/${playwrightLoadProfileReportFile}' '${reportDir}/summary.json' '${reportDir}/samples.json' \\
          '${eventsFile}'
        JENKINS_NODE_COOKIE=dontKillMe nohup node scripts/playwright-load-monitor.js \\
          --output-folder '${reportDir}' \\
          --label '${label}' \\
          --events-file '${eventsFile}' \\
          --stop-file '${reportDir}/stop' \\
          > '${reportDir}/monitor.log' 2>&1 &
        echo \$! > '${reportDir}/monitor.pid'
    """
}

def stopPlaywrightLoadProfile = { String reportDir ->
    steps.sh """
        set +e
        touch '${reportDir}/stop'
        if [ -s '${reportDir}/monitor.pid' ]; then
          monitorPid=\$(cat '${reportDir}/monitor.pid')
          case "\$monitorPid" in
            ''|*[!0-9]*)
              echo "[playwright-load-profile] ignoring invalid monitor PID: \$monitorPid"
              ;;
            *)
              monitorCommand=\$(ps -p "\$monitorPid" -o args= 2>/dev/null || true)
              case "\$monitorCommand" in
                *"scripts/playwright-load-monitor.js"*"--output-folder ${reportDir}"*)
                  deadline=\$((\$(date +%s) + 5))
                  while kill -0 "\$monitorPid" 2>/dev/null && [ "\$(date +%s)" -lt "\$deadline" ]; do
                    sleep 1
                  done
                  if kill -0 "\$monitorPid" 2>/dev/null; then
                    kill -TERM "\$monitorPid" 2>/dev/null
                    sleep 1
                  fi
                  if kill -0 "\$monitorPid" 2>/dev/null; then
                    kill -KILL "\$monitorPid" 2>/dev/null
                  fi
                  ;;
                *)
                  echo "[playwright-load-profile] ignoring PID that does not own ${reportDir}: \$monitorPid"
                  ;;
              esac
              ;;
          esac
        fi
    """
}

