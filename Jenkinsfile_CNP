                                    "PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES=${params.PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES ? 'true' : 'false'}",
                                    'PLAYWRIGHT_OUTPUT_DIR=functional-output/tests/playwright-e2e/odhin-report/test-results',
                                    'PLAYWRIGHT_JUNIT_OUTPUT=functional-output/tests/playwright-e2e/odhin-report/playwright-junit.xml'
                                ]) {
                                    yarnBuilder.yarn('test:playwrightE2E:raw')
                                    e2eOutcome = 'completed'
                                }
                            } catch (Exception e) {
                                if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                                    throw e
                                }
                                if (e instanceof hudson.AbortException && ((e.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
                                    throw e
                                }
                                e2eOutcome = 'test-failure'
                                echo "[parallel-report-gathering] Playwright E2E failed: ${e.getClass().getName()}: ${e.getMessage()}"
                                throw e
                            } finally {
                                recordPlaywrightLoadEvent(playwrightLoadProfileEventsFile('aat'), 'E2E', 'finish')
                                ensureHtmlReportForPublishing(
                                    'functional-output/tests/playwright-e2e/odhin-report',
                                    'xui-playwright-e2e.html',
                                    'AAT Playwright E2E',
                                    e2eOutcome
                                )
                                publishHTML([
                                    allowMissing         : true,
                                    alwaysLinkToLastBuild: true,
                                    keepAll              : true,
                                    reportDir            : "functional-output/tests/playwright-e2e/odhin-report/",
                                    reportFiles          : 'xui-playwright-e2e.html',
                                    reportName           : 'AAT Playwright E2E'
                                ])
                                publishPlaywrightJUnit('functional-output/tests/playwright-e2e/odhin-report/playwright-junit.xml', e2eOutcome)
                            }
                        }
                    }
                ]

                if (params.RUN_PLAYWRIGHT_ACCESSIBILITY) {
                    aatFunctionalSuites = [failFast: false]
                    aatFunctionalSuites.playwrightAccessibility = {
                        stage('Playwright Accessibility Tests') {
                            try {
                                recordPlaywrightLoadEvent(playwrightLoadProfileEventsFile('aat'), 'Accessibility', 'start')
                                withEnv([
                                    "ORG_USER_ASSIGNMENT_MODE=external",
                                    "ORG_USER_ASSIGNMENT_MODE_ORDER=external,internal",
                                    "PW_ACCESSIBILITY_WORKERS=6",
                                    "FUNCTIONAL_TESTS_WORKERS=6",
                                    "PW_SESSION_CAPTURE_FAILURE_TTL_MS=0",
                                    "PLAYWRIGHT_SKIP_INSTALL=true",
                                    "PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES=${params.PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES ? 'true' : 'false'}"
                                ]) {
                                    yarnBuilder.yarn('test:accessibility:playwright')
                                }
                                assertHtmlReportExists(
                                    playwrightAccessibilityReportDir,
                                    playwrightAccessibilityReportFile
                                )
                            } catch (Exception e) {
                                if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                                    throw e
                                }
                                if (e instanceof hudson.AbortException && ((e.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
                                    throw e
                                }
                                currentBuild.result = 'UNSTABLE'
                                echo "[parallel-report-gathering] Playwright Accessibility failed; marking build unstable so a manual accessibility-only run cannot hide missing Odhín evidence: ${e.getClass().getName()}: ${e.getMessage()}"
                            } finally {
                                recordPlaywrightLoadEvent(playwrightLoadProfileEventsFile('aat'), 'Accessibility', 'finish')
                                publishPlaywrightAccessibilityJUnit()
                                try {
                                    publishPlaywrightAccessibilityReport('AAT Playwright Accessibility')
                                } catch (Exception publishException) {
                                    if (publishException instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                                        throw publishException
                                    }
                                    if (publishException instanceof hudson.AbortException && ((publishException.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
                                        throw publishException
                                    }
                                    echo "[playwright-accessibility] Report publish wrapper failed but is non-blocking: ${publishException.getClass().getName()}: ${publishException.getMessage()}"
                                }
                            }
                        }
                    }
                } else {
                    echo '[playwright-accessibility] CNP stage omitted by default. Set RUN_PLAYWRIGHT_ACCESSIBILITY=true on a manual build to run only this pack.'
                }

                parallel(aatFunctionalSuites)
            } finally {
                recordPlaywrightLoadEvent(aatLoadProfileEvents, 'AAT functional tests', 'finish')
                archivePlaywrightDiagnostics()
                publishCiLoadProfile('AAT CI System Load')
            }
        }
    }
}
