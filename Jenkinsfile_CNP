def resolveIntegrationProfileRuns = { String configuredRuns, String workersOverride, String shardOverride ->
    def requestedWorkers = workersOverride?.trim()
    if (requestedWorkers) {
        def requestedShard = shardOverride?.trim()
        return ["workers=${requestedWorkers}${requestedShard ? " shard=${requestedShard}" : ''}"]
    }
    def configured = configuredRuns?.trim()
    if (!configured) {
        configured = 'workers=7'
    }
    return configured
        .split(/[\r\n;]+/)
        .collect { it.trim() }
        .findAll { it }
}

def integrationProfileRunConfig = { String spec, String testType ->
    def workers = '7'
    def shard = ''
    spec.split(/\s+/).each { token ->
        if (token.startsWith('workers=')) {
            workers = token.replaceFirst('workers=', '')
        }
        if (token.startsWith('shard=')) {
            shard = token.replaceFirst('shard=', '')
        }
    }
    def safeName = "workers-${workers}${shard ? "-shard-${shard}" : ''}".replaceAll(/[^A-Za-z0-9._-]/, '-')
    return [
        workers: workers,
        shard: shard,
        shardArg: shard ? " --shard=${shard}" : '',
        label: "${testType}-${safeName}",
        reportDir: "functional-output/tests/playwright-integration/odhin-report/${testType}-${safeName}",
        displayName: "${workers} workers${shard ? ", shard ${shard}" : ''}"
    ]
}

def runPlaywrightIntegrationProfileMatrix = { String testType, String reportNamePrefix ->
    def failures = []
    resolveIntegrationProfileRuns(params.INTEGRATION_PW_PROFILE_RUNS ?: '', params.INTEGRATION_PW_WORKERS ?: '', params.INTEGRATION_PW_SHARD ?: '').each { spec ->
        def runConfig = integrationProfileRunConfig(spec, testType)
        def sessionConfigCompleteFile = "${runConfig.reportDir}/session-configuration.complete"
        def junitFile = "${runConfig.reportDir}/playwright-junit.xml"
        def outcome = 'interrupted'
        def runnerCompleted = false
        sh "rm -f -- '${sessionConfigCompleteFile}'"
        try {
            withEnv([
                "PLAYWRIGHT_REPORT_FOLDER=${runConfig.reportDir}",
                "PLAYWRIGHT_OUTPUT_DIR=${runConfig.reportDir}/test-results",
                "PLAYWRIGHT_JUNIT_OUTPUT=${junitFile}",
                "PW_LOAD_PROFILE_EVENTS_FILE=${playwrightLoadProfileEventsFile(testType)}",
                "TEST_TYPE=${testType}",
                "ORG_USER_ASSIGNMENT_MODE=external",
                "ORG_USER_ASSIGNMENT_MODE_ORDER=external,internal",
                "FUNCTIONAL_TESTS_WORKERS=${runConfig.workers}",
                "PW_INTEGRATION_SESSION_CONFIGURATION_COMPLETE_FILE=${sessionConfigCompleteFile}",
                "INTEGRATION_PW_INCLUDE_TAGS=${params.INTEGRATION_PW_INCLUDE_TAGS ?: ''}",
                "INTEGRATION_PW_EXCLUDED_TAGS_OVERRIDE=${params.INTEGRATION_PW_EXCLUDED_TAGS_OVERRIDE ?: ''}",
                "PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES=${params.PLAYWRIGHT_IGNORE_GLOBAL_EXCLUDES ? 'true' : 'false'}"
            ]) {
                yarnBuilder.yarn("test:playwright:integration:raw -- --workers=${runConfig.workers}${runConfig.shardArg}")
            }
            runnerCompleted = true
            outcome = 'completed'
            echo "[playwright-integration] Completed test command for ${runConfig.displayName}; checking Odhín report at ${runConfig.reportDir}/${playwrightIntegrationReportFile}"
            assertHtmlReportExists(runConfig.reportDir, playwrightIntegrationReportFile)
            echo "[playwright-integration] Odhín report exists for ${runConfig.displayName}"
        } catch (Exception e) {
            if (e instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                throw e
            }
            if (e instanceof hudson.AbortException && ((e.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
                throw e
            }
            outcome = runnerCompleted ? 'completed' : 'test-failure'
            if (!fileExists(sessionConfigCompleteFile)) {
                steps.sh "mkdir -p '${runConfig.reportDir}'"
                writeFile(
                    file: "${runConfig.reportDir}/runner-failure.txt",
                    text: 'Integration session configuration did not complete before Playwright started. See the Jenkins console log for the configuration error.\n'
                )
                echo "[playwright-integration] Session configuration validation did not complete for ${runConfig.displayName}; aborting before another profile starts"
                throw e
            }
            failures << "${runConfig.displayName}: ${e.getMessage()}"
        } finally {
            try {
                echo "[playwright-integration] Publishing Odhín HTML report for ${runConfig.displayName}"
                ensureHtmlReportForPublishing(
                    runConfig.reportDir,
                    playwrightIntegrationReportFile,
                    "${reportNamePrefix} Playwright Integration Tests",
                    outcome
                )
                publishHTML([
                    allowMissing         : true,
                    alwaysLinkToLastBuild: true,
                    keepAll              : true,
                    reportDir            : "${runConfig.reportDir}/",
                    reportFiles          : playwrightIntegrationReportFile,
                    reportName           : "${reportNamePrefix} Playwright Integration Tests"
                ])
                junit allowEmptyResults: false, testResults: junitFile
                echo "[playwright-integration] Published Odhín HTML report for ${runConfig.displayName}"
            } catch (Exception publishException) {
                if (publishException instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
                    throw publishException
                }
                if (publishException instanceof hudson.AbortException && ((publishException.getMessage() ?: '') =~ /(exit code|status)\s+(129|137|143)/).find()) {
                    throw publishException
                }
                def publishFailure = "${runConfig.displayName} report publication: ${publishException.getMessage()}"
                failures << publishFailure
                echo "[playwright-integration] ${publishFailure}"
            }
        }
    }
    if (failures) {
        error("Playwright integration profile matrix failed:\n${failures.join('\n')}")
    }
}

