def archivePlaywrightDiagnostics = {
    steps.sh '''
        set +e
        out_dir="functional-output/tests/playwright-diagnostics/failure-data"
        mkdir -p "${out_dir}"
        if [ -d test-results ]; then
          find test-results -type f -name 'failure-data.json' | while read -r file; do
            rel="${file#test-results/}"
            safe_name=$(echo "${rel}" | tr '/ ' '__')
            cp "${file}" "${out_dir}/${safe_name}"
          done
        fi
    '''
    steps.archiveArtifacts(
        allowEmptyArchive: true,
        artifacts: 'functional-output/tests/playwright-diagnostics/failure-data/**/*,functional-output/tests/**/test-results/**/failure-data.json,functional-output/tests/**/test-results/**/trace.zip,functional-output/tests/**/test-results/**/*.png,functional-output/tests/**/test-results/**/*.jpg,functional-output/tests/**/test-results/**/*.jpeg',
        excludes: 'functional-output/tests/**/test-results/.playwright-artifacts-*/**,**/.playwright-artifacts-*/**'
    )
}

